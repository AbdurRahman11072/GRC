# App Configuration (Next.js + Express Hybrid)
NODE_ENV=development
PORT=5000
NEXT_PUBLIC_APP_URL=http://localhost:5000

# Neon DB (Serverless PostgreSQL)
DATABASE_URL="postgresql://neondb_owner:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://neondb_owner:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"

# JWT Authentication
JWT_ACCESS_SECRET="super-secret-jwt-access-key-change-in-production"
JWT_REFRESH_SECRET="super-secret-jwt-refresh-key-change-in-production"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
COOKIE_SECRET="super-secret-cookie-signing-key"

# Cloudflare R2 Storage (S3-compatible)
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="zio-tech-grc-evidence"
R2_PUBLIC_DOMAIN=""
