{
  "name": "zio-tech-grc",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Enterprise-grade multi-tenant SaaS platform for IS audits and regulatory compliance (Next.js 16 + Express.js Hybrid)",
  "scripts": {
    "dev": "nodemon --watch server --watch tsconfig.server.json --ext ts --exec \"tsx --tsconfig tsconfig.server.json\" server/index.ts",
    "build": "npx prisma generate && next build && tsc --project tsconfig.server.json",
    "build:frontend": "npx prisma generate && next build",
    "build:server": "npx prisma generate && tsc --project tsconfig.server.json",
    "start": "tsx server/index.ts",
    "mg": "npx prisma migrate dev",
    "ge": "npx prisma generate",
    "push": "npx prisma db push",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.server.json --noEmit",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.750.0",
    "@aws-sdk/s3-request-presigner": "^3.750.0",
    "@prisma/adapter-pg": "^6.4.1",
    "@prisma/client": "^6.4.1",
    "@reduxjs/toolkit": "^2.13.0",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.66.9",
    "argon2": "^0.41.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "http-status": "^2.1.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^1.16.0",
    "next": "^16.0.0",
    "pg": "^8.13.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-redux": "^9.3.0",
    "tailwind-merge": "^3.0.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.8",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.4",
    "@types/pg": "^8.11.11",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "nodemon": "^3.1.9",
    "postcss": "^8.5.2",
    "prisma": "^6.4.1",
    "tailwindcss": "^4.0.8",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
